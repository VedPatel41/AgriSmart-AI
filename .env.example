# Environment variable configuration template for AgriSmart AI
# Copy this file to .env and supply actual keys when integrating external services.

OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional / Deprecated:
# Claude is not required. Google Gemini is the single GenAI provider for AgriSmart.
# CLAUDE_API_KEY=

